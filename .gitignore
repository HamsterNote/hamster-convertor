# 依赖目录（体积巨大，无业务逻辑）
node_modules/

# 构建输出和打包目录
dist/
build/
out/
.output/
.next/
target/

# 环境变量和敏感配置文件（防止泄露密钥）
.env
.env.local
.env.*
*.key
*.pem

# 日志和缓存文件
*.log
logs/
.cache/
*.tmp

# 系统文件
.DS_Store
Thumbs.db

# 代码覆盖率报告
coverage/
.nyc_output/

# Playwright 产物
playwright-report/
test-results/

# IDE和编辑器配置（可选）
.vscode/
.idea/
.history/

# OpenCode 配置（工具本地配置）
.opencode/
.specify/

# OpenCode 工作流产出（计划、证据、笔记等）
.omo/

# Yalc 本地包管理
.yalc/

# ts 增量编译
*.tsbuildinfo

# Codemap 状态文件（工具内部状态）
.slim/
