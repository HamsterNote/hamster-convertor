# 依赖目录（体积巨大，无业务逻辑）
node_modules/

# 构建输出和打包目录
dist/
build/
out/
.output/
.next/
target/

# 环境变量和敏感配置文件（防止泄露密钥）
.env
.env.local
.env.*
*.key
*.pem

# 日志和缓存文件
*.log
logs/
.cache/
*.tmp

# 系统文件
.DS_Store
Thumbs.db

# 代码覆盖率报告
coverage/
.nyc_output/

# Playwright 产物
playwright-report/
test-results/

# IDE和编辑器配置（可选）
.vscode/
.idea/
.history/

# OpenCode 配置（工具本地配置）
.opencode/
.specify/

# OpenCode 工作流产出（计划、证据、笔记等）
.omo/

# Yalc 本地包管理
# 注意：.yalc/ 与 yalc.lock 需要进入 git，
# 因为部分依赖（如 @hamster-note/markdown-parser）通过 yalc 链接到本地，
# 如果忽略 .yalc/，CI 上 `yarn install --frozen-lockfile` 会因找不到
# `file:.yalc/...` 路径而失败。
# 因此这里仅忽略 .yalc 临时缓存，不忽略目录本身。

# ts 增量编译
*.tsbuildinfo

# CodeGraph 索引缓存（工具内部状态）
.codegraph/

# Codemap 状态文件（工具内部状态）
.slim/
